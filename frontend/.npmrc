# Relax minimum release age policy for CI
# This allows recently published packages to be installed
minimum-release-age=0

# Allow all build scripts to run
# This is needed for packages like esbuild and msw that compile native binaries
ignore-build-scripts=false

# Override electron-to-chromium to older version (pnpm 10.x setting)
# The latest version triggers minimum release age policy
overrides.electron-to-chromium=1.5.389

# Approve build scripts for specific packages (pnpm 10.x setting)
only-built-dependencies[]=esbuild
only-built-dependencies[]=msw
